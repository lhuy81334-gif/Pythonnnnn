# Cấu hình tài khoản Gmail nhận (Victim / Receiver)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Cấu hình kiểm tra email
POLL_INTERVAL_SECONDS=5

# Cấu hình cảnh báo tấn công Flood (dồn dập)
FLOOD_WINDOW_SECONDS=60
FLOOD_EMAIL_THRESHOLD=5
FLOOD_SIMILARITY_THRESHOLD=0.75
